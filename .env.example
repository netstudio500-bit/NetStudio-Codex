# NetStudio-Codex Configuration

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Application Configuration
APP_NAME=NetStudio-Codex
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./netstudio.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/netstudio

# Vector Store Configuration
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=4

# WebSocket Configuration
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8001

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Docker Compose
# Set a unique value before starting the stack.
POSTGRES_PASSWORD=change-me-before-use

# Memory Configuration
MAX_MEMORY_SIZE=1000
MEMORY_RETENTION_DAYS=90

# Workspace Configuration
WORKSPACE_ROOT=./workspaces
MAX_WORKSPACE_SIZE=10GB

# Plugin Configuration
PLUGIN_DIRECTORY=./plugins
AUTO_LOAD_PLUGINS=true

# Recovery Configuration
CHECKPOINT_INTERVAL=300
MAX_CHECKPOINTS=10

# Tools Configuration
TOOLS_TIMEOUT=30
MAX_TOOL_WORKERS=4

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8001
